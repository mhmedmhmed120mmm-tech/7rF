{
  "expo": {
    "name": "SevenRF-App",
    "slug": "SevenRF-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/VrF.png",
    "scheme": "sevenrf",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/VrF.png"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.sevenrf.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/VrF.png",
          "imageWidth": 250
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/SevenRF-App"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5d95a76f-1bde-44a9-b8ab-0bb0c9409848"
      }
    }
  }
}
