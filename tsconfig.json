{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "**/*.backup.ts",
    "**/*.backup.tsx",
    "**/*.before-*.ts",
    "**/*.before-*.tsx",
    "**/*.current-backup.ts",
    "**/*.current-backup.tsx",
    "**/*.livekit-disabled-backup.ts",
    "**/*.livekit-disabled-backup.tsx"
  ]
}
